# Postgres
# - Local: docker compose up -d
# - Producción (Vercel): Supabase → Connect → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/equilibrio

# Vercel Blob (imágenes en producción). Vercel lo crea en Storage → Blob.
# Vacío en local = las imágenes se guardan en public/media
BLOB_READ_WRITE_TOKEN=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
